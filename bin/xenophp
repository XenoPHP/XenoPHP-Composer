#!/usr/bin/env php
<?php

if ($argc < 3 || $argv[1] !== 'new') {
    echo "XenoPHP Installer\n";
    echo "Usage: xenophp new <project-name>\n";
    exit(1);
}

$projectName = $argv[2];

echo "Creating a new XenoPHP application: $projectName\n\n";

$command = "composer create-project xenophp/xenophp \"$projectName\" --no-scripts";
passthru($command, $status);

if ($status === 0) {
    $appPhpPath = getcwd() . DIRECTORY_SEPARATOR . $projectName . DIRECTORY_SEPARATOR . 'bootstrap' . DIRECTORY_SEPARATOR . 'app.php';
    if (file_exists($appPhpPath)) {
        $appPhpContent = file_get_contents($appPhpPath);
        $appPhpContent = str_replace('vendor/xenophp/xenophp/Routes', 'vendor/xenophp/xeno/Routes', $appPhpContent);
        file_put_contents($appPhpPath, $appPhpContent);
    }

    echo "\nRunning post-install setup...\n";
    chdir(getcwd() . DIRECTORY_SEPARATOR . $projectName);
    passthru("composer run-script post-root-package-install", $status1);
    passthru("composer run-script post-create-project-cmd", $status2);
    passthru("composer dump-autoload", $status3);

    echo "\nApplication ready! Build something amazing.\n";
} else {
    echo "\nInstallation failed.\n";
    exit($status);
}
